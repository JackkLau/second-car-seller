{
  "name": "cardisplay-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 *.test.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "migrate": "node --env-file-if-exists=.env cli.mjs migrate",
    "ingest": "node --env-file-if-exists=.env cli.mjs fetch",
    "import": "node --env-file-if-exists=.env cli.mjs import"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
