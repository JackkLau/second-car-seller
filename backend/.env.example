# 复制为 backend/.env 并填写本地配置；不要提交真实密码或授权凭证。
POSTGRES_USER=cardisplay
POSTGRES_DB=cardisplay
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cardisplay:replace_with_a_long_random_password@127.0.0.1:5432/cardisplay
API_PORT=8787
# 至少 32 个字符；只读 API 通过 Authorization: Bearer <token> 访问。
API_READ_TOKEN=replace_with_a_separate_random_read_token
