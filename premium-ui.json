{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "zh-CN",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Date",
    "Form",
    "Scrollbar",
    "Toast"
  ],
  "ownership": { "Select/Listbox": "native", "Date": "authored" },
  "requiredCommands": ["unit", "typecheck", "build", "e2e"],
  "commands": {
    "unit": "npm test",
    "typecheck": "npm run typecheck",
    "build": "npm run build",
    "e2e": "npm run test:e2e"
  }
}
